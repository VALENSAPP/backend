generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                    @id @default(uuid())
  firebaseUserId        String?                   @unique
  email                 String?                   @unique
  password              String?
  googleId              String?                   @unique
  twitterId             String?                   @unique
  appleId               String?                   @unique
  // Valens stores only user <-> public wallet mapping (non-custodial). No private keys.
  walletAddress         String?                   @unique
  registrationType      RegistrationType
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  age                   Int?
  deletedAt             DateTime?
  gender                Gender?
  image                 String?
  otp                   String?
  otpExpiresAt          DateTime?
  phoneNumber           String?
  isDeleted             Int                       @default(0)
  verifyEmail           Int                       @default(0)
  bio                   String?
  displayName           String?                   @unique
  userName              String?
  profile               String?                   @default("user") @db.VarChar(255)
  // DEPRECATED per Valens requirements: Valens does not create wallets or control private keys.
  walletMnemonic        String?
  walletPrivateKey      String?
  currentPeriodEnd      DateTime?
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  subscriptionEnd       DateTime?
  subscriptionStart     DateTime?
  subscriptionStatus    SubscriptionStatus        @default(INACTIVE)
  // DEPRECATED per Valens requirements: No internal balances or credits; revenue from software/Stripe only.
  tokenBalance          Float                     @default(0)
  kyc                   Boolean                   @default(false)
  first_log             Boolean                   @default(true)
  stripeAccountId       String?
  stripeBankAccountId   String?
  /// ISO country at registration/origin (e.g. BR, US). Used to pick payment provider.
  country               String?
  /// STRIPE | PAGBANK — set at registration from country/origin.
  paymentProvider       String                    @default("STRIPE")
  pagbankAccountId      String?
  pagbankCustomerId     String?
  pagbankAccessToken    String?                   @db.Text
  pagbankRefreshToken   String?                   @db.Text
  pagbankTokenExpiresAt DateTime?
  refreshToken          String?
  refreshTokenExpiresAt DateTime?
  profileStatus         String                    @default("public")
  fansPage              Int                       @default(0)
  twoFact               Int                       @default(0)
  twoFactorSecret       String?
  website_link          String?
  social_media_links    Json?
  fcmToken              String?
  language              String                    @default("en")
  canAccessPlatform     String                    @default("false")
  bannedUntil           DateTime?
  isBlocked             Boolean                   @default(false)
  blockedReason         String?
  blockedAt             DateTime?
  screenshotAttempts    Int                       @default(0)
  referCode             String?
  referPoints           Float                     @default(0)
  totalPlatformPoints   Float                     @default(0)
  marketplaceBattlePoints Float                   @default(0)
  shopPlatformPoints    Float                     @default(0)
  blockedBy             BlockedUser[]             @relation("Blocked")
  blockedUsers          BlockedUser[]             @relation("Blocker")
  followings            FollowerAndFollowing[]    @relation("Follower")
  followers             FollowerAndFollowing[]    @relation("Following")
  hidePosts             HidePost[]
  payments              Payment[]                 @relation("PaymentPayer")
  receivedPayments      Payment[]                 @relation("PaymentReceiver")
  tokenPurchases        TokenPurchase[]
  tokenSales            TokenSale[]
  donationData          DonationData[]
  posts                 Post[]
  privateCircles        PrivateCircle[]
  privateCircleMembers  PrivateCircleMember[]
  postReports           PostReport[]
  postComments          PostComment[]
  postCommentReactions  PostCommentReaction[]
  postLikes             PostLike[]
  receivedPosts         PostShare[]               @relation("ReceivedBy")
  sharedPosts           PostShare[]               @relation("SharedBy")
  savedPosts            SavePost[]
  pinnedPosts           PinnedPost[]
  stories               Story[]
  storyHighlights       StoryHighlight[]
  StoryComment          StoryComment[]
  storyLike             StoryLike[]
  storyViewsAsViewer    StoryView[]               @relation("StoryViewViewer")
  storyViewsAsOwner     StoryView[]               @relation("StoryViewOwner")
  sentConversations     Conversation[]            @relation("ConversationSender")
  receivedConversations Conversation[]            @relation("ConversationReceiver")
  userTokens            UserToken[]
  postHits              PostHit[]
  platformPointsHitPurchases PlatformPointsHitPurchase[]
  withdrawalRecords     WithdrawalRecord[]
  kycs                  Kyc[]
  userSubscriptions     UserSubscription[]
  fansSubscriptions     FansSubscriptionBuyData[] @relation("Fan")
  boughtSubscriptions   FansSubscriptionBuyData[] @relation("Buy")

  loginHistories              LoginHistory[]
  searchHistories             SearchHistory[]            @relation("UserSearchHistories")
  searchedInHistories         SearchHistory[]            @relation("SearchedTargetUsers")
  sessions                    UserSession[]
  sentChats                   ChatBox[]                  @relation("ChatSender")
  receivedChats               ChatBox[]                  @relation("ChatReceiver")
  notifications               Notification[]
  companyProfile              CompanyProfile?
  postMessage                 PostMessage?
  sentDigitalTransactions     digital_transaction[]      @relation("Sender")
  receivedDigitalTransactions digital_transaction[]      @relation("Receiver")
  referredUsers               UserReferral[]             @relation("UserReferrer")
  referredBy                  UserReferral[]             @relation("UserReferred")
  battlesCreated              Battle[]                   @relation("BattleCreator")
  battlesWon                  Battle[]                   @relation("BattleWinner")
  externalPredictionVotes     BattleExternalPredictionVote[]
  battleInvitesSent           BattleInvite[]             @relation("BattleInviter")
  battleInvitesReceived       BattleInvite[]             @relation("BattleInvited")
  battleParticipants          BattleParticipant[]
  battlePredictions           BattlePrediction[]
  battleComments              BattleComment[]
  battleCommentLikes          BattleCommentLike[]
  battleVotes                 BattleVote[]
  battleRewards               BattleReward[]
  battleActivities            BattleActivity[]
  battleAchievements          BattleAchievement[]
  marketplaceBattlesCreated   MarketplaceBattle[]        @relation("MarketplaceBattleSeller")
  marketplaceBattlesAsOpponent MarketplaceBattle[]       @relation("MarketplaceBattleOpponentSeller")
  marketplaceBattleVotes      MarketplaceBattleVote[]    @relation("MarketplaceBattleVoter")
  marketplaceBattleComments   MarketplaceBattleComment[] @relation("MarketplaceBattleCommentAuthor")
  marketplaceBattleCommentReactions MarketplaceBattleCommentReaction[]
  marketplaceBattleViews      MarketplaceBattleView[]
  marketplaceWinnerPromotions MarketplaceWinnerPromotion[]
  marketplaceBattleBoosts     MarketplaceBattleBoost[]
  marketplaceBattlePointsAwards MarketplaceBattlePointsAward[]
  marketplaceBattleChallengesSent     MarketplaceBattleChallengeInvite[] @relation("MarketplaceBattleChallengeInviter")
  marketplaceBattleChallengesReceived MarketplaceBattleChallengeInvite[] @relation("MarketplaceBattleChallengeInvited")
  battleStats                 UserBattleStats?
  deviceAccounts              DeviceAccount[]
  trustVotes                  PostTrustVote[]
  mycloset                    Mycloset?
  closetItems                 ClosetItems[]
  closetViews                 ClosetView[]
  closetItemLikes             ClosetItemLike[]
  carts                       Cart[]
  wishlists                   Wishlist[]
  shopEbooks                  ShopEbook[]
  shopEbookPaymentsAsBuyer    ShopEbookPayments[]        @relation("ShopEbookPaymentBuyer")
  shopEbookPaymentsAsSeller   ShopEbookPayments[]        @relation("ShopEbookPaymentSeller")
  marketPlaceOrders           MarketPlaceOrder[]
  ordersAsBuyer               Order[]                    @relation("OrderBuyer")
  ordersAsSeller              Order[]                    @relation("OrderSeller")
  closetChatThreadsAsBuyer    ClosetChatThread[]         @relation("ClosetChatBuyer")
  closetChatThreadsAsSeller   ClosetChatThread[]         @relation("ClosetChatSeller")
  closetChatMessagesSent      ClosetChatMessage[]        @relation("ClosetChatMessageSender")
  closetChatMessagesReceived  ClosetChatMessage[]        @relation("ClosetChatMessageReceiver")
  ebookPaymentsAsBuyer        EbookPayments[]            @relation("EbookPaymentBuyer")
  ebookPaymentsAsSeller       EbookPayments[]            @relation("EbookPaymentSeller")
  userAddrees                 UserAddrees[]
  sellerWallets               SellerWallet[]
  walletLedgerEntries         WalletLedgerEntry[]
  sentPlatformPointTransfers     PlatformPointTransfer[] @relation("SentPlatformPointTransfers")
  receivedPlatformPointTransfers PlatformPointTransfer[] @relation("ReceivedPlatformPointTransfers")
  shopRewardPointsAwards         ShopRewardPointsAward[] @relation("UserShopRewardPointsAwards")
  loyaltyAccounts                UserLoyaltyAccount[]
  pointsRedemptions              PointsRedemption[]

  // Trust & Safety Architecture
  accountStanding                AccountStanding         @default(GOOD)
  standingReason                 String?
  standingUntil                  DateTime?
  standingWarningCount           Int                     @default(0)
  standingStrikeCount            Int                     @default(0)
  moderationCases                ModerationCase[]        @relation("SubjectUserCases")
  accountViolations              AccountViolation[]      @relation("UserViolations")
  filedReports                   UniversalReport[]       @relation("ReporterReports")
  receivedReports                UniversalReport[]       @relation("ReportedUserReports")
  muting                         UserMute[]              @relation("UserMuters")
  mutedBy                        UserMute[]              @relation("UserMuted")
}


model Mycloset {
  id                 String              @id @default(uuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName           String
  shopUsername       String              @unique
  shopLogo           String?
  description        String?             @db.Text
  shopCategory       String?
  location           String?
  whoCanBuy          WhoCanBuy           @default(Everyone)
  paymentMethod      String?
  shippingOptions    ShippingOptions     @default(ship_items)
  returnPolicy       String?             @db.Text
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  closetItems        ClosetItems[]
  closetViews        ClosetView[]
  orders             Order[]
  marketplaceBattles MarketplaceBattle[] @relation("MarketplaceBattlePrimaryCloset")
  opponentMarketplaceBattles MarketplaceBattle[] @relation("MarketplaceBattleOpponentCloset")
  winnerPromotions   MarketplaceWinnerPromotion[]
  battleBoosts       MarketplaceBattleBoost[]
  shopEbooks         ShopEbook[]
  shopEbookPayments  ShopEbookPayments[]

  @@index([userId])
  @@index([shopUsername])
}

model ClosetView {
  id        String   @id @default(uuid())
  closetId  String
  viewerId  String
  createdAt DateTime @default(now())
  closet    Mycloset @relation(fields: [closetId], references: [id], onDelete: Cascade)
  viewer    User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@index([closetId])
  @@index([viewerId])
}

model ClosetItems {
  id                            String                         @id @default(uuid())
  closetId                      String
  userId                        String
  images                        String[]                       @default([])
  name                          String
  category                      String
  brand                         String?
  condition                     ClosetItemCondition
  description                   String?                        @db.Text
  price                         Float
  quantity                      Int                            @default(1)
  isActive                      Boolean                        @default(true)
  isDeleted                     Boolean                        @default(false)
  soldCount                     Int                            @default(0)
  shippingOption                ShippingOptions
  shippingFee                   Float?
  estimateShippingTime          String?
  pickupAddress                 String?                        @db.Text
  pickupAvailableHours          String?
  pickUpCity                    String?
  residentNumber                String?
  buyerChatEnabled              Boolean?
  returnPolicy                  String?                        @db.Text
  moderationStatus              ModerationStatus               @default(APPROVED)
  moderationReason              String?                        @db.Text
  moderationScore               Float?
  moderatedBy                   String?
  moderatedAt                   DateTime?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  closet                        Mycloset                       @relation(fields: [closetId], references: [id], onDelete: Cascade)
  user                          User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartItems                     CartItems[]
  wishlistItems                 WishlistItems[]
  likes                         ClosetItemLike[]
  orderItems                    MarketPlaceOrderItem[]
  orderSnapshots                OrderItem[]
  marketplaceBattleParticipants MarketplaceBattleParticipant[]
  winnerPromotions              MarketplaceWinnerPromotion[]

  @@index([closetId])
  @@index([userId])
  @@index([category])
  @@index([moderationStatus])
  @@map("closetItems")
}

model ClosetItemLike {
  id           String      @id @default(uuid())
  closetItemId String
  userId       String
  createdAt    DateTime    @default(now())
  closetItem   ClosetItems @relation(fields: [closetItemId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([closetItemId, userId])
  @@index([closetItemId])
  @@index([userId])
}

model Cart {
  id        String      @id @default(uuid())
  userId    String
  sellerId  String
  closetId  String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  cartItems CartItems[]

  @@unique([userId, sellerId, closetId])
  @@index([userId])
  @@index([sellerId])
  @@index([closetId])
  @@map("cart")
}

model CartItems {
  id                     String                  @id @default(uuid())
  cartId                 String
  productId              String
  quantity               Int                     @default(1)
  price                  Float
  subtotal               Float
  selectedShippingChoice CartItemShippingChoice?
  selectedShippingFee    Float                   @default(0)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  cart                   Cart                    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product                ClosetItems             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cartItems")
}

model Wishlist {
  id            String          @id @default(uuid())
  userId        String
  sellerId      String
  closetId      String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  wishlistItems WishlistItems[]

  @@unique([userId, sellerId, closetId])
  @@index([userId])
  @@index([sellerId])
  @@index([closetId])
  @@map("wishlist")
}

model WishlistItems {
  id         String      @id @default(uuid())
  wishlistId String
  productId  String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  wishlist   Wishlist    @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    ClosetItems @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
  @@map("wishlistItems")
}

model ShopEbook {
  id           String   @id @default(uuid())
  userId       String
  closetId     String
  caption      String?
  text         String?
  images       String[] @default([])
  ebookpdf     String
  amount       Float
  isDownload   Boolean  @default(true)
  promoCode    String?
  tableContent     String[]            @default([])
  moderationStatus ModerationStatus    @default(APPROVED)
  moderationReason String?             @db.Text
  moderationScore  Float?
  moderatedBy      String?
  moderatedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  closet           Mycloset            @relation(fields: [closetId], references: [id], onDelete: Cascade)
  payments         ShopEbookPayments[]

  @@index([userId])
  @@index([closetId])
  @@index([createdAt])
  @@index([moderationStatus])
  @@map("shopEbooks")
}

model ShopEbookPayments {
  id                String    @id @default(uuid())
  buyerId           String
  sellerId          String
  closetId          String
  ebookId           String
  amount            Int
  platformFee       Int
  sellerAmount      Int
  currency          String    @default("usd")
  status            String    @default("PENDING")
  provider          String    @default("STRIPE")
  checkoutSessionId String?   @unique
  paymentIntentId   String?   @unique
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  buyer             User      @relation("ShopEbookPaymentBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller            User      @relation("ShopEbookPaymentSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  closet            Mycloset  @relation(fields: [closetId], references: [id], onDelete: Cascade)
  ebook             ShopEbook @relation(fields: [ebookId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@index([sellerId])
  @@index([closetId])
  @@index([ebookId])
  @@index([status])
  @@index([createdAt])
  @@map("shopEbookPayments")
}

model UserAddrees {
  id              String   @id @default(uuid())
  userId          String
  fullName        String
  phoneNumber     String
  alternateNumber String?
  addressLine1    String
  addressLine2    String?
  city            String
  state           String
  country         String
  postalCode      String
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders          Order[]

  @@index([userId])
  @@index([isDefault])
}

model CompanyProfile {
  id                               String    @id @default(uuid())
  userId                           String    @unique
  user                             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName                     String?
  ownerName                        String?
  email                            String?
  phone                            String?
  category                         String?
  address                          String?
  description                      String?   @db.Text
  website                          String?
  gstNumber                        String?
  documentUrls                     String[]  @default([])
  sumSubApplicantId                String?
  documentVerificationStatus       String?
  documentVerificationAt           DateTime?
  documentVerificationRejectReason String?
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt

  @@index([userId])
}

model PostMessage {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageForPhotos  String?  @db.Text
  messageForVideos  String?  @db.Text
  messageForEbooks  String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

model Post {
  id               String          @id @default(uuid())
  text             String?
  images           String[]
  thumbnails       String[]        @default([])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  userId           String
  deletedAt        DateTime?
  isDelete         isdelete        @default(no)
  caption          String?
  hashtag          String[]
  location         String?
  music            String?
  youtubeMusicMeta Json?
  taggedPeople     String[]
  raiseAmount      Float?
  start_time       DateTime?
  end_time         DateTime?
  type             String?
  link             String?
  visibleTo        String?
  privateCircleId  String?
  format           format          @default(image)
  postHide         postHide        @default(no)
  isTrustPost      Boolean         @default(false)
  videoText        Boolean         @default(false)
  videoTextItems   Json?
  ebookpdf         String?
  tableContent     String[]
  allowDownload    Boolean         @default(true)
  amount           Float?
  promoCode        String?
  moderationStatus ModerationStatus @default(APPROVED)
  moderationReason String?          @db.Text
  moderationScore  Float?
  moderatedBy      String?
  moderatedAt      DateTime?
  ebookPayments    EbookPayments[]
  hides            HidePost[]
  reports          PostReport[]
  user             User            @relation(fields: [userId], references: [id])
  privateCircle    PrivateCircle?  @relation(fields: [privateCircleId], references: [id], onDelete: SetNull)
  comments         PostComment[]
  likes            PostLike[]
  shares           PostShare[]
  saves            SavePost[]
  pinnedBy         PinnedPost[]
  trustVotes       PostTrustVote[]
  postHashtags     PostHashtag[]

  @@index([privateCircleId])
  @@index([moderationStatus])
}

model Hashtag {
  id         String        @id @default(uuid())
  tag        String        @unique
  usageCount Int           @default(0)
  postCount  Int           @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  posts      PostHashtag[]

  @@index([usageCount])
  @@index([postCount])
  @@index([lastUsedAt])
}

model PostHashtag {
  id        String   @id @default(uuid())
  postId    String
  hashtagId String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag   Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@unique([postId, hashtagId])
  @@index([postId])
  @@index([hashtagId])
  @@index([createdAt])
}

model PrivateCircle {
  id        String                @id @default(uuid())
  ownerId   String
  owner     User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isActive  Boolean               @default(true)
  minSlots  Int
  maxSlots  Int
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  members   PrivateCircleMember[]
  posts     Post[]

  @@unique([ownerId])
  @@index([ownerId])
}

model PrivateCircleMember {
  id              String                    @id @default(uuid())
  privateCircleId String
  userId          String
  status          PrivateCircleMemberStatus @default(ACTIVE)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  privateCircle   PrivateCircle             @relation(fields: [privateCircleId], references: [id], onDelete: Cascade)
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([privateCircleId, userId])
  @@index([userId])
  @@index([privateCircleId, status])
}

model PinnedPost {
  id       String   @id @default(uuid())
  postId   String
  userId   String
  pinnedAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, pinnedAt])
  @@index([postId])
}

model PostLike {
  id            String   @id @default(uuid())
  postId        String
  userId        String
  isReadByOwner Boolean  @default(false)
  createdAt     DateTime @default(now())
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostComment {
  id          String                @id @default(uuid())
  postId      String
  userId      String
  comment     String
  parentId    String?
  commentType      cmntType              @default(NORMAL)
  moderationStatus ModerationStatus      @default(APPROVED)
  moderationReason String?               @db.Text
  moderationScore  Float?
  moderatedBy      String?
  moderatedAt      DateTime?
  createdAt        DateTime              @default(now())
  post             Post                  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent           PostComment?          @relation("PostCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies          PostComment[]         @relation("PostCommentThread")
  reactions        PostCommentReaction[]

  @@index([postId])
  @@index([userId])
  @@index([parentId])
  @@index([moderationStatus])
}

model PostCommentReaction {
  id        String       @id @default(uuid())
  commentId String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  comment   PostComment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model SavePost {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@index([postId])
}

// Follow/Unfollow: platform records relationship. Follow Pass (NFT/soulbound) mint/burn is user wallet-signed on-chain.
model FollowerAndFollowing {
  id          String       @id @default(uuid())
  followerId  String
  followingId String
  status      FollowStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  follower    User         @relation("Follower", fields: [followerId], references: [id])
  following   User         @relation("Following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id])
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id])

  @@unique([blockerId, blockedId])
}

model PostShare {
  id             String   @id @default(uuid())
  postId         String
  sharedUserId   String
  receiverUserId String
