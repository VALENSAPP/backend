  txType     String
  txValue    Decimal  @db.Decimal(18, 8)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   User @relation("Sender", fields: [senderId], references: [id])
  receiver User @relation("Receiver", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
}

model UserReferral {
  id                 String   @id @default(uuid())
  referrerId         String
  referredUserId     String
  referrerPoints     Int?
  referredUserPoints Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  referrer     User @relation("UserReferrer", fields: [referrerId], references: [id])
  referredUser User @relation("UserReferred", fields: [referredUserId], references: [id])

  @@unique([referrerId, referredUserId])
}

model Battle {
  id               String       @id @default(uuid())
  creatorId        String
  format           BattleFormat
  battleType       BattleType   @default(NORMAL)
  status           BattleStatus @default(DRAFT)
  question         String
  options          String[]     @default([])
  optionImages     String[]     @default([])
  startTime        DateTime?
  endTime          DateTime
  resolutionMethod String?
  isPublic         Boolean      @default(true)
  stakeAmount      Float?
  image            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  liveAt           DateTime?
  closedAt         DateTime?
  resolvedAt       DateTime?
  winningSide      String?
  correctSide      String?
  winnerUserId     String?

  creator      User                @relation("BattleCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  winner       User?               @relation("BattleWinner", fields: [winnerUserId], references: [id])
  externalPrediction BattleExternalPredictionMarket?
  invites      BattleInvite[]
  participants BattleParticipant[]
  predictions  BattlePrediction[]
  comments     BattleComment[]
  votes        BattleVote[]
  rewards      BattleReward[]
  activities   BattleActivity[]
  achievements BattleAchievement[]

  @@index([creatorId])
  @@index([status])
  @@index([format])
  @@index([battleType])
}

model BattleExternalPredictionMarket {
  id               String                       @id @default(uuid())
  battleId          String                       @unique
  provider          PredictionProvider
  category          PredictionCategory
  externalMarketId  String
  externalEventId   String?
  question          String
  options           String[]                     @default([])
  providerStatus    String?
  resultSide        String?
  resultRaw         Json?
  raw               Json?
  closeTime         DateTime?
  lastSyncedAt      DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  battle Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  votes  BattleExternalPredictionVote[]

  @@index([provider, externalMarketId])
  @@index([category])
  @@index([providerStatus])
}

model BattleExternalPredictionVote {
  id              String   @id @default(uuid())
  predictionId    String
  userId          String
  selectedSide    String
  createdAt       DateTime @default(now())

  prediction BattleExternalPredictionMarket @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  user       User                           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([predictionId, userId])
  @@index([userId])
}

model BattleInvite {
  id            String             @id @default(uuid())
  battleId      String
  inviterId     String
  invitedUserId String
  status        BattleInviteStatus @default(PENDING)
  createdAt     DateTime           @default(now())
  respondedAt   DateTime?

  battle  Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  inviter User   @relation("BattleInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invited User   @relation("BattleInvited", fields: [invitedUserId], references: [id], onDelete: Cascade)

  @@unique([battleId, invitedUserId])
  @@index([inviterId])
  @@index([invitedUserId])
}

model BattleParticipant {
  id                String    @id @default(uuid())
  battleId          String
  userId            String
  side              String?
  openingArgument   String?   @db.Text
  joinedAt          DateTime  @default(now())
  score             Int       @default(0)
  stakeWon          Float     @default(0)
  baseJoinPoints    Int       @default(0)
  argumentPoints    Int       @default(0)
  engagementPoints  Int       @default(0)
  timingBonus       Int       @default(0)
  underdogBonus     Int       @default(0)
  winnerBonus       Int       @default(0)
  loserPenalty      Int       @default(0)
  argumentSubmitted Boolean   @default(false)
  likesCount        Int       @default(0)
  votePoints        Int       @default(0)
  isWinner          Boolean   @default(false)
  awardedAt         DateTime?

  battle Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([battleId, userId])
  @@index([battleId])
  @@index([userId])
}

model UserBattleStats {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  totalBattlePoints       Int      @default(0)
  totalStakeWon           Float    @default(0)
  totalBattlesJoined      Int      @default(0)
  totalBattlesWon         Int      @default(0)
  totalPredictionsCorrect Int      @default(0)
  totalPredictionsWrong   Int      @default(0)
  totalArgumentsSubmitted Int      @default(0)
  totalArgumentLikes      Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BattlePrediction {
  id            String   @id @default(uuid())
  battleId      String
  userId        String
  side          String
  justification String
  sourceUrl     String?
  createdAt     DateTime @default(now())

  battle Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([battleId, userId])
  @@index([battleId])
  @@index([userId])
}

model BattleComment {
  id        String    @id @default(uuid())
  battleId  String
  userId    String
  comment   String
  images    String[]  @default([])
  highlight Json?
  isPin     Boolean   @default(false)
  pinnedAt  DateTime?
  parentId  String?
  createdAt DateTime  @default(now())

  battle  Battle              @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  BattleComment?      @relation("BattleCommentThread", fields: [parentId], references: [id])
  replies BattleComment[]     @relation("BattleCommentThread")
  likes   BattleCommentLike[]

  @@index([battleId])
  @@index([userId])
}

model BattleCommentLike {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment BattleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model BattleVote {
  id        String   @id @default(uuid())
  battleId  String
  userId    String
  side      String
  createdAt DateTime @default(now())

  battle Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([battleId, userId])
  @@index([battleId])
  @@index([userId])
}

model BattleReward {
  id           String   @id @default(uuid())
  battleId     String
  userId       String
  rank         Int?
  rewardPoints Float?
  rewardType   String?  @default("CRED")
  createdAt    DateTime @default(now())

  battle Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([battleId])
  @@index([userId])
}

model BattleAchievement {
  id          String   @id @default(uuid())
  userId      String
  battleId    String?
  code        String
  title       String
  description String?
  unlockedAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  battle Battle? @relation(fields: [battleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([battleId])
  @@index([code])
}

model BattleActivity {
  id        String   @id @default(uuid())
  userId    String
  battleId  String?
  type      String
  data      Json?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  battle Battle? @relation(fields: [battleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([battleId])
  @@index([type])
}

model MarketplaceBattle {
  id                  String                   @id @default(uuid())
  sellerId            String
  closetId            String
  title               String
  description         String?                  @db.Text
  category            String?
  visibility          WhoCanBuy                @default(Everyone)
  whoCanVote          WhoCanBuy                @default(Everyone)
  shareToFeed         Boolean                  @default(false)
  status              MarketplaceBattleStatus  @default(DRAFT)
  outcome             MarketplaceBattleOutcome @default(PENDING)
  startAt             DateTime?
  endAt               DateTime?
  publishedAt         DateTime?
  completedAt         DateTime?
  winnerParticipantId String?
  totalVotes          Int                      @default(0)
  totalComments       Int                      @default(0)
  mode                MarketplaceBattleMode    @default(SAME_CLOSET)
  question            String?
  stakeAmount         Float?
  stakeSettled        Boolean                  @default(false)
  opponentSellerId    String?
  opponentClosetId    String?
  inviteExpiresAt     DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  seller            User                           @relation("MarketplaceBattleSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  opponentSeller    User?                          @relation("MarketplaceBattleOpponentSeller", fields: [opponentSellerId], references: [id], onDelete: Restrict)
  closet            Mycloset                       @relation("MarketplaceBattlePrimaryCloset", fields: [closetId], references: [id], onDelete: Restrict)
  opponentCloset    Mycloset?                      @relation("MarketplaceBattleOpponentCloset", fields: [opponentClosetId], references: [id], onDelete: Restrict)
  participants      MarketplaceBattleParticipant[] @relation("MarketplaceBattleParticipants")
  votes             MarketplaceBattleVote[]
  comments          MarketplaceBattleComment[]
  views             MarketplaceBattleView[]
  winnerParticipant MarketplaceBattleParticipant?  @relation("MarketplaceBattleWinner", fields: [winnerParticipantId], references: [id], onDelete: SetNull)
  winnerPromotions  MarketplaceWinnerPromotion[]
  boosts            MarketplaceBattleBoost[]
  pointsAwards      MarketplaceBattlePointsAward[]
  challengeInvite   MarketplaceBattleChallengeInvite?

  @@index([sellerId])
  @@index([closetId])
  @@index([opponentSellerId])
  @@index([opponentClosetId])
  @@index([status])
  @@index([mode])
  @@index([startAt])
  @@index([endAt])
  @@index([inviteExpiresAt])
  @@index([status, startAt])
  @@index([status, endAt])
}

model MarketplaceBattleChallengeInvite {
  id                  String             @id @default(uuid())
  battleId            String             @unique
  inviterId           String
  invitedUserId       String
  challengerProductId String
  opponentProductId   String
  status              BattleInviteStatus @default(PENDING)
  createdAt           DateTime           @default(now())
  respondedAt         DateTime?

  battle  MarketplaceBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  inviter User              @relation("MarketplaceBattleChallengeInviter", fields: [inviterId], references: [id], onDelete: Restrict)
  invited User              @relation("MarketplaceBattleChallengeInvited", fields: [invitedUserId], references: [id], onDelete: Restrict)

  @@index([inviterId])
  @@index([invitedUserId])
  @@index([status])
}

model MarketplaceBattleParticipant {
  id        String   @id @default(uuid())
  battleId  String
  productId String
  position  Int
  voteCount Int      @default(0)
  isWinner  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  battle     MarketplaceBattle       @relation("MarketplaceBattleParticipants", fields: [battleId], references: [id], onDelete: Cascade)
  product    ClosetItems             @relation(fields: [productId], references: [id], onDelete: Restrict)
  votes      MarketplaceBattleVote[]
  wonBattles MarketplaceBattle[]     @relation("MarketplaceBattleWinner")
  winnerPromotions MarketplaceWinnerPromotion[]

  @@unique([battleId, productId])
  @@unique([battleId, position])
  @@index([battleId])
  @@index([productId])
}

model MarketplaceBattleVote {
  id            String   @id @default(uuid())
  battleId      String
  participantId String
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  battle      MarketplaceBattle            @relation(fields: [battleId], references: [id], onDelete: Cascade)
  participant MarketplaceBattleParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  user        User                         @relation("MarketplaceBattleVoter", fields: [userId], references: [id], onDelete: Restrict)

  /// IMPORTANT: The DB cannot enforce that `participantId` belongs to the same `battleId`.
  /// This must be validated in the service layer during vote creation/update.
  @@unique([battleId, userId])
  @@index([battleId])
  @@index([participantId])
  @@index([userId])
}

model MarketplaceBattleComment {
  id        String    @id @default(uuid())
  battleId  String
  userId    String
  comment   String    @db.Text
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  battle MarketplaceBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user   User              @relation("MarketplaceBattleCommentAuthor", fields: [userId], references: [id], onDelete: Restrict)
  reactions MarketplaceBattleCommentReaction[]

  @@index([battleId])
  @@index([userId])
  @@index([createdAt])
  @@index([battleId, createdAt])
}

model MarketplaceBattleCommentReaction {
  id        String       @id @default(uuid())
  commentId String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  comment MarketplaceBattleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@index([type])
}

model MarketplaceBattleView {
  id        String   @id @default(uuid())
  battleId  String
  viewerId  String
  createdAt DateTime @default(now())

  battle MarketplaceBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  viewer User             @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@index([battleId])
  @@index([viewerId])
}

model MarketplaceBattlePointsAward {
  id String @id @default(uuid())

  battleId String
  userId   String

  score            Int @default(0)
  baseJoinPoints   Int @default(0)
  argumentPoints   Int @default(0)
  engagementPoints Int @default(0)
  timingBonus      Int @default(0)
  winnerBonus      Int @default(0)
