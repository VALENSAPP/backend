model SearchHistory {
  id             String    @id @default(uuid())
  userId         String
  query          String?
  searchedUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation("UserSearchHistories", fields: [userId], references: [id], onDelete: Cascade)
  searchedUser   User?     @relation("SearchedTargetUsers", fields: [searchedUserId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([searchedUserId])
  @@index([userId, updatedAt])
}

enum RewardProvider {
  MERIT
  POINTS_COM
  EXPEDIA
  INTERNAL
}

enum RedemptionCategory {
  AIRLINE_MILES
  HOTEL_POINTS
  TRAVEL_BOOKING
  GIFT_CARD
  SHOPPING
  EXPERIENCES
  MISSION_POSTS
}

enum RedemptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

model UserLoyaltyAccount {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      RewardProvider
  programCode   String
  programName   String
  accountNumber String
  accountName   String?
  isVerified    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, provider, programCode, accountNumber])
  @@index([userId])
}

model PointsRedemption {
  id                   String             @id @default(uuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             RewardProvider
  category             RedemptionCategory
  partnerProgramCode   String?
  valensPointsSpent    Float
  rewardAmountReceived Float
  exchangeRate         Float
  feePoints            Float              @default(0)
  status               RedemptionStatus   @default(PENDING)
  externalReferenceId  String?
  idempotencyKey       String             @unique
  metadata             Json?
  failureReason        String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

enum ModerationStatus {
  APPROVED
  PENDING_APPROVAL
  REJECTED
}

enum ModerationContentType {
  POST
  COMMENT
  PRODUCT
  EBOOK
}

model ModerationAuditLog {
  id            String                @id @default(uuid())
  contentType   ModerationContentType
  contentId     String
  authorId      String
  aiVerdict     ModerationStatus
  aiReason      String?               @db.Text
  aiConfidence  Float?
  flaggedLabels String[]              @default([])
  adminAction   ModerationStatus?
  adminReason   String?               @db.Text
  adminId       String?
  caseId        String?
  actorType     String                @default("SYSTEM")
  previousState String?
  newState      String?
  action        String?
  metadata      Json?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([contentType, contentId])
  @@index([authorId])
  @@index([aiVerdict])
  @@index([createdAt])
  @@index([caseId])
}

