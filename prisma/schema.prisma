model MarketplaceWinnerPromotion {
  id            String                          @id @default(uuid())
  sellerId      String
  closetId      String
  battleId      String
  participantId String
  productId     String
  packageId     String?
  paymentId     String?
  promoType     MarketplaceWinnerPromotionType?
  message       String?
  discountPercent Int?
  freeShipping Boolean                         @default(false)
  originalPrice Float?
  promoPrice    Float?
  originalShippingFee Float?
  promoShippingFee Float?
  amount        Decimal?                        @db.Decimal(12, 2)
  currency      String?
  paymentProvider String?
  status        MarketplaceWinnerPromotionStatus @default(PENDING_PAYMENT)
  startAt       DateTime?
  endAt         DateTime?
  activatedAt   DateTime?
  expiredAt     DateTime?
  cancelledAt   DateTime?
  failedAt      DateTime?
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt

  seller      User                       @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  closet      Mycloset                   @relation(fields: [closetId], references: [id], onDelete: Restrict)
  battle      MarketplaceBattle          @relation(fields: [battleId], references: [id], onDelete: Restrict)
  participant MarketplaceBattleParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  product     ClosetItems                @relation(fields: [productId], references: [id], onDelete: Restrict)
  package     MarketplaceWinnerPromotionPackage? @relation(fields: [packageId], references: [id], onDelete: Restrict)
  payment     MarketPlacePayments?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([sellerId])
  @@index([closetId])
  @@index([battleId])
  @@index([productId])
  @@index([packageId])
  @@index([paymentId])
  @@index([status, startAt])
  @@index([status, endAt])
}

model MarketplaceBattleBoostPackage {
  id            String                  @id @default(uuid())
