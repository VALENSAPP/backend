model Order {
  id                    String               @id @default(uuid())
  orderNumber           String               @unique
  buyerId               String
  sellerId              String
  closetId              String
  addressId             String?
  paymentId             String?
  subtotal              Float
  shippingCost          Float
  serviceFee            Float
  total                 Float
  paymentMethod         String
  paymentStatus         PaymentStatus
  orderStatus           OrderStatus
  shippingCarrier       String?
  trackingNumber        String?
  estimatedDelivery     DateTime?
  // EasyPost / carrier tracking (optional — manual ship/deliver still supported)
  shippingStatus        ShippingStatus       @default(NOT_SHIPPED)
  easypostTrackerId     String?
  trackingValidatedAt   DateTime?
  carrierDeliveredAt    DateTime?
  shippingProvider      String?              // e.g. EASYPOST | MANUAL
  lastTrackingPayload   Json?
  // Delivery-gated escrow payout (Stripe Connect separate charges + transfers)
  platformFeeMinor      Int?
  sellerAmountMinor     Int?
  sellerStripeAccountId String?
  stripeChargeId        String?
  transferStatus        TransferStatus       @default(PENDING)
  stripeTransferId      String?
  protectionEndsAt      DateTime?
  deliveredAt           DateTime?
  deliveryOtp           String?
  deliveryOtpExpiresAt  DateTime?
  deliveryOtpSentAt     DateTime?
  payoutReleasedAt      DateTime?
  disputeStatus         DisputeStatus        @default(NONE)
  disputeReason         String?
  // Cancellation and Refund tracking
  cancellationStatus    CancellationStatus   @default(NONE)
  cancellationReason    String?
  cancellationDeclineReason String?
  cancelledBy           String?              // BUYER | SELLER | ADMIN
  cancellationRequestedAt DateTime?
  cancellationRespondedAt DateTime?
  cancellationAgreedAt  DateTime?
  refundId              String?
  refundAmount          Float?
  refundedAt            DateTime?
  refundStatus          String?              // NONE | PENDING | REFUNDED | FAILED
  isViewedBySeller      Boolean              @default(false)
  sellerViewedAt        DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  buyer                 User                 @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller                User                 @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  closet                Mycloset             @relation(fields: [closetId], references: [id], onDelete: Restrict)
  address               UserAddrees?         @relation(fields: [addressId], references: [id], onDelete: SetNull)
  payment               MarketPlacePayments? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  closetChatThreads     ClosetChatThread[]
  shopRewardPointsAward ShopRewardPointsAward?

  @@index([buyerId, createdAt])
  @@index([sellerId, orderStatus])
  @@index([sellerId, isViewedBySeller])
  @@index([sellerId, paymentStatus, createdAt])
  @@index([sellerId, transferStatus, createdAt])
  @@index([paymentId])
  @@index([transferStatus, protectionEndsAt])
  @@index([easypostTrackerId])
  @@index([trackingNumber])
  @@index([shippingStatus])
}

model ClosetChatThread {
