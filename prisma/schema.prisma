model WithdrawalRecord {
  id             String    @id @default(uuid())
  userId         String
  withdrawAmount Float?
  amountMinor    Int?
  currency       String    @default("usd")
  provider       String    @default("STRIPE") // STRIPE | PAGBANK
  txhash         String?
  transferId     String? // Stripe transfer id or PagBank payout id
  status         String    @default("pending") // pending, processing, processing_transfer, success, failed, requires_onboarding
  failureReason  String?
  processingAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([provider])
  @@index([createdAt])
